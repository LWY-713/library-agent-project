# 复制本文件为 .env 后填入真实值。.env 已在 .gitignore 中，不会入库。

# ===== 对话模型（DeepSeek）=====
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.6

# ===== 向量化服务（二选一）=====
# 方案 A：硅基流动 BAAI/bge-m3（1024 维，默认）
EMBEDDING_API_KEY=你的向量服务密钥
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 方案 B：阿里百炼 text-embedding-v4（1024 维）——注释掉上面四行，改用下面四行
# EMBEDDING_API_KEY=你的百炼密钥
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=1024

# ===== 检索 / 建库 =====
TOP_K=3
CHUNK_SIZE=200
CHUNK_OVERLAP=80
SEARCH_MIN_SCORE=0
MILVUS_DB_PATH=./milvus_library.db

# ===== Agent =====
MAX_TOOL_ROUNDS=12
STREAM_OUTPUT=false
DEBUG=true

# ===== 借阅业务 =====
CURRENT_USER_ID=2023001
